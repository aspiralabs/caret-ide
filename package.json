{
  "name": "caret",
  "version": "0.2.0",
  "description": "Caret — the IDE, your way. A customizable three-panel Electron IDE.",
  "main": "./out/main/index.js",
  "author": "Aspira Labs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w node-pty",
    "cli:link": "mkdir -p \"$HOME/.local/bin\"; ln -sf \"$PWD/bin/caret\" /opt/homebrew/bin/caret 2>/dev/null || ln -sf \"$PWD/bin/caret\" /usr/local/bin/caret 2>/dev/null || ln -sf \"$PWD/bin/caret\" \"$HOME/.local/bin/caret\"; echo 'Linked caret. Ensure its dir is on PATH.'",
    "cli:unlink": "rm -f /opt/homebrew/bin/caret /usr/local/bin/caret \"$HOME/.local/bin/caret\"",
    "postinstall": "electron-rebuild -f -w node-pty",
    "pack:mac": "electron-vite build && electron-builder --mac --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "release:mac": "electron-vite build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.40.0",
    "marked": "^18.0.11",
    "node-pty": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.7.1",
    "@monaco-editor/react": "^4.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.52.2",
    "node-gyp": "^13.0.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.2"
  }
}
